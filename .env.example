PORT=5000
MONGO_URI=your_mongodb_connection_string
# Cab road routing: use a Mapbox Directions-enabled token on the backend.
# Vercel's NEXT_PUBLIC_MAPBOX_API_KEY does not set this Render variable.
MAPBOX_API_KEY=

# Firebase Admin: use one complete Firebase-generated JSON key, never the browser config.
# Set this to the same project used by the frontend.
FIREBASE_PROJECT_ID=apex-5b654
# Choose JSON or BASE64, not both. Keep credentials out of Git and screenshots.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Razorpay (Payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree (eKYC & Identity)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=SANDBOX

# Resend (Emails)
RESEND_API_KEY=

# Eko API (Utility Bill Payments)
EKO_DEV_KEY=
EKO_ACCESS_KEY=
EKO_INITIATOR_ID=
EKO_USER_CODE=
EKO_BASE_URL=https://api.eko.in:25002/ekoicici/v1
EKO_LATLONG=
RAZORPAY_WEBHOOK_SECRET=
