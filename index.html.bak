<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>APEX | Rise • Innovate • Excel</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Tailwind Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        apex: {
                            brown: '#A0684A', // Matched from the APEX STORE logo in the image
                            brownhover: '#87563c',
                            green: '#25D366', // WhatsApp Green
                            dark: '#222222',
                            lightbg: '#FFFFFF',
                            graybg: '#F9FAFB'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #FFFFFF;
            color: #222222;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            pointer-events: none;
            background:
                radial-gradient(circle at 10% 10%, rgba(160, 104, 74, 0.06), transparent 28%),
                radial-gradient(circle at 90% 20%, rgba(37, 211, 102, 0.05), transparent 22%),
                radial-gradient(circle at 50% 100%, rgba(160, 104, 74, 0.04), transparent 30%);
            z-index: 0;
        }

        body > * {
            position: relative;
            z-index: 1;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #A0684A; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #87563c; }

        /* Product Card Image Zoom on Hover */
        .product-img-container { overflow: hidden; }
        .product-img { transition: transform 0.5s ease; }
        .product-card:hover .product-img { transform: scale(1.05); }

        /* Finance quick actions */
        .finance-panel {
            box-shadow: 0 14px 40px rgba(0, 0, 0, 0.06);
        }

        .finance-action-icon {
            width: 4.5rem;
            height: 4.5rem;
            border-radius: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            background: linear-gradient(180deg, #f4f8ff 0%, #edf4ff 100%);
            color: #1f5fa8;
            border: 1px solid #d8e5fb;
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85);
        }

        .finance-action-icon--gold {
            background: linear-gradient(180deg, #fff7e8 0%, #fff0d2 100%);
            border-color: #f0dfad;
            color: #a06d15;
        }

        .finance-action-icon--dark {
            background: linear-gradient(180deg, #f5f7fb 0%, #edf1f7 100%);
            border-color: #dce3ee;
            color: #35507a;
        }

        .finance-action-label {
            line-height: 1.15;
        }

        .hero-glow {
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18);
            -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
        }

        .hero-stat-card {
            transition: transform 0.25s ease, border-color 0.25s ease, background-color 0.25s ease;
        }

        .hero-stat-card:hover {
            transform: translateY(-2px);
            border-color: rgba(255, 255, 255, 0.28);
            background-color: rgba(255, 255, 255, 0.14);
        }

        .carousel-viewport {
            overflow: hidden;
            position: relative;
        }

        .carousel-track {
            display: flex;
            gap: 2rem;
            will-change: transform;
            transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
        }

        .carousel-card {
            flex: 0 0 100%;
        }

        @media (min-width: 768px) {
            .carousel-card {
                flex-basis: calc(50% - 1rem);
            }
        }

        @media (min-width: 1024px) {
            .carousel-card {
                flex-basis: calc(33.333% - 1.333rem);
            }
        }

        .carousel-progress {
            width: 100%;
            height: 4px;
            border-radius: 999px;
            background: rgba(160, 104, 74, 0.12);
            overflow: hidden;
        }

        .carousel-progress > span {
            display: block;
            height: 100%;
            width: 0;
            background: #A0684A;
            border-radius: inherit;
            transition: width 300ms ease;
        }

        /* Loader */
        #loader {
            position: fixed;
            inset: 0;
            background: #FFFFFF;
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: opacity 0.5s ease;
        }

        /* Presentation Animations */
        .reveal-up {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .reveal-left {
            opacity: 0;
            transform: translateX(-40px);
            transition: all 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .reveal-right {
            opacity: 0;
            transform: translateX(40px);
            transition: all 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .reveal-zoom {
            opacity: 0;
            transform: scale(0.9);
            transition: all 0.8s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .reveal-active {
            opacity: 1 !important;
            transform: translate(0) scale(1) !important;
        }
        
        /* Staggered Delays */
        .delay-100 { transition-delay: 100ms; }
        .delay-200 { transition-delay: 200ms; }
        .delay-300 { transition-delay: 300ms; }
        .delay-400 { transition-delay: 400ms; }
        .delay-500 { transition-delay: 500ms; }
        .delay-600 { transition-delay: 600ms; }
        .delay-700 { transition-delay: 700ms; }
        .delay-800 { transition-delay: 800ms; }
    </style>
</head>
<body class="font-sans antialiased relative">

    <!-- Initial Loader -->
    <div id="loader">
        <div class="flex flex-col items-center animate-pulse">
            <div class="font-bold text-3xl tracking-widest text-apex-brown mb-2">APEX</div>
            <div class="h-1 w-12 bg-apex-brown rounded-full"></div>
        </div>
    </div>

    <!-- Navigation (Matched to Image 1) -->
    <nav class="bg-white fixed w-full z-50 transition-all duration-300 border-b border-gray-100 py-3" id="navbar">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center">
                
                <!-- Logo -->
                <div class="flex-shrink-0 flex items-center cursor-pointer" onclick="window.scrollTo(0,0)">
                    <img src="./APEX%20logo.jpeg" alt="APEX logo" class="h-10 w-10 object-contain rounded shadow-sm mr-3">
                    <span class="hidden sm:inline font-bold text-xl tracking-wider text-apex-brown uppercase">APEX</span>
                </div>

                <!-- Desktop Menu -->
                <div class="hidden lg:flex items-center space-x-4">
                    <a href="#home" class="text-apex-brown font-medium hover:text-apex-brownhover text-sm transition-colors">Home</a>
                    <a href="#store" class="text-apex-brown font-medium hover:text-apex-brownhover text-sm transition-colors flex items-center">Store <i class="fa-solid fa-chevron-down ml-1 text-xs"></i></a>
                    <a href="#finance" class="text-apex-brown/80 hover:text-apex-brown text-sm font-medium transition-colors">Finance</a>
                    <a href="#realty" class="text-apex-brown/80 hover:text-apex-brown text-sm font-medium transition-colors">Realty</a>
                    <a href="#academy" class="text-apex-brown/80 hover:text-apex-brown text-sm font-medium transition-colors">Academy</a>
                    <a href="#matrimony" class="text-apex-brown/80 hover:text-apex-brown text-sm font-medium transition-colors">Matrimony</a>
                    <a href="#utility" class="text-apex-brown/80 hover:text-apex-brown text-sm font-medium transition-colors">Utility</a>
                    <a href="#profile" class="text-apex-brown/80 hover:text-apex-brown text-sm font-medium transition-colors">Profile</a>
                    <a href="#foundation" class="text-apex-brown/80 hover:text-apex-brown text-sm font-medium transition-colors">Foundation</a>
                </div>

                <!-- Icons (WhatsApp, Search, Cart, Profile) -->
                <div class="hidden md:flex items-center space-x-5">
                    <a href="https://wa.me/919494273763" class="text-apex-green hover:opacity-80 transition-opacity text-xl" aria-label="Open WhatsApp" title="Open WhatsApp"><i class="fa-brands fa-whatsapp"></i><span class="sr-only">Open WhatsApp</span></a>
                    <button type="button" class="text-apex-brown hover:text-apex-brownhover transition-colors text-lg" aria-label="Search" title="Search"><i class="fa-solid fa-search"></i><span class="sr-only">Search</span></button>
                    <a href="#store" class="text-apex-brown hover:text-apex-brownhover transition-colors text-lg relative">
                        <i class="fa-solid fa-shopping-cart"></i>
                        <span class="absolute -top-2 -right-2 bg-red-500 text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold">3</span>
                    </a>
                    <div class="relative" id="profile-menu-wrapper">
                        <button id="profile-menu-btn" type="button" class="flex items-center text-apex-brown hover:text-apex-brownhover transition-colors cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Open profile menu" title="Open profile menu">
                            <i class="fa-solid fa-user text-lg"></i>
                            <i class="fa-solid fa-chevron-down ml-1 text-[10px]"></i>
                        </button>
                        <div id="profile-menu" class="hidden absolute right-0 top-full mt-3 w-56 rounded-2xl border border-gray-100 bg-white shadow-xl overflow-hidden z-50">
                            <div class="px-4 py-4 border-b border-gray-100">
                                <p class="text-sm font-semibold text-gray-900">Guest Profile</p>
                                <p class="text-xs text-gray-500 mt-1">Sign in to manage your orders and settings</p>
                            </div>
                            <a href="#" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition-colors">My Profile</a>
                            <a href="#" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition-colors">Orders</a>
                            <a href="#" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition-colors">Wishlist</a>
                            <a href="#" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition-colors">Settings</a>
                        </div>
                    </div>
                </div>

                <!-- Mobile menu button -->
                <div class="lg:hidden flex items-center space-x-3 sm:space-x-4">
                    <a href="https://wa.me/919494273763" class="text-apex-green hover:opacity-80 transition-opacity text-lg" aria-label="Open WhatsApp" title="Open WhatsApp"><i class="fa-brands fa-whatsapp"></i><span class="sr-only">Open WhatsApp</span></a>
                    <button type="button" class="text-apex-brown hover:text-apex-brownhover transition-colors text-base sm:text-lg" aria-label="Search" title="Search"><i class="fa-solid fa-search"></i><span class="sr-only">Search</span></button>
                    <a href="#store" class="text-apex-brown hover:text-apex-brownhover transition-colors text-lg relative" aria-label="View cart" title="View cart">
                        <i class="fa-solid fa-shopping-cart"></i>
                        <span class="absolute -top-2 -right-2 bg-red-500 text-white text-[10px] w-4 h-4 rounded-full flex items-center justify-center font-bold">3</span>
                    </a>
                    <div class="relative" id="mobile-profile-menu-wrapper">
                        <button id="mobile-profile-menu-btn" type="button" class="flex items-center text-apex-brown hover:text-apex-brownhover transition-colors cursor-pointer" aria-haspopup="true" aria-expanded="false" aria-label="Open profile menu" title="Open profile menu">
                            <i class="fa-solid fa-user text-base sm:text-lg"></i>
                        </button>
                        <div id="mobile-profile-menu" class="hidden absolute right-0 top-full mt-3 w-52 rounded-2xl border border-gray-100 bg-white shadow-xl overflow-hidden z-50">
                            <div class="px-4 py-4 border-b border-gray-100">
                                <p class="text-sm font-semibold text-gray-900">Guest Profile</p>
                                <p class="text-xs text-gray-500 mt-1">Sign in to manage your orders and settings</p>
                            </div>
                            <a href="#" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition-colors">My Profile</a>
                            <a href="#" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition-colors">Orders</a>
                            <a href="#" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition-colors">Wishlist</a>
                            <a href="#" class="block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 transition-colors">Settings</a>
                        </div>
                    </div>
                    <button id="mobile-menu-btn" type="button" class="text-apex-brown focus:outline-none text-2xl" aria-label="Open menu" title="Open menu">
                        <i class="fa-solid fa-bars"></i><span class="sr-only">Open menu</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100 mt-3 absolute w-full left-0 shadow-lg pb-4">
            <div class="flex flex-col px-4 pt-2 space-y-1">
                <a href="#home" class="mobile-link text-gray-800 hover:text-apex-brown hover:bg-gray-50 block px-3 py-3 rounded-md font-medium border-b border-gray-50">Home</a>
                <a href="#store" class="mobile-link text-gray-800 hover:text-apex-brown hover:bg-gray-50 block px-3 py-3 rounded-md font-medium border-b border-gray-50">Store</a>
                <a href="#finance" class="mobile-link text-gray-800 hover:text-apex-brown hover:bg-gray-50 block px-3 py-3 rounded-md font-medium border-b border-gray-50">Finance</a>
                <a href="#realty" class="mobile-link text-gray-800 hover:text-apex-brown hover:bg-gray-50 block px-3 py-3 rounded-md font-medium border-b border-gray-50">Realty</a>
                <a href="#academy" class="mobile-link text-gray-800 hover:text-apex-brown hover:bg-gray-50 block px-3 py-3 rounded-md font-medium border-b border-gray-50">Academy</a>
                <a href="#matrimony" class="mobile-link text-gray-800 hover:text-apex-brown hover:bg-gray-50 block px-3 py-3 rounded-md font-medium border-b border-gray-50">Matrimony</a>
                <a href="#utility" class="mobile-link text-gray-800 hover:text-apex-brown hover:bg-gray-50 block px-3 py-3 rounded-md font-medium border-b border-gray-50">Utility</a>
                <a href="#profile" class="mobile-link text-gray-800 hover:text-apex-brown hover:bg-gray-50 block px-3 py-3 rounded-md font-medium border-b border-gray-50">Profile</a>
                <a href="#foundation" class="mobile-link text-gray-800 hover:text-apex-brown hover:bg-gray-50 block px-3 py-3 rounded-md font-medium">Foundation</a>
            </div>
        </div>
    </nav>

    <!-- HERO SECTION (Matched to Image 1) -->
    <section id="home" class="relative pt-[64px] min-h-[600px] h-[80vh] flex items-center">
        <!-- Background Image -->
        <div class="absolute inset-0 z-0">
            <img src="./Apex%20Hero(Apex%20Store).jpeg" alt="APEX hero background" class="w-full h-full object-cover">
            <!-- Gradient Overlay for text readability (Dark to transparent) -->
            <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/40 to-transparent"></div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
            <div class="max-w-xl">
                <!-- Small inset image mimicking the screenshot -->
                <div class="w-16 h-16 rounded mb-6 hidden md:block overflow-hidden hero-glow ring-1 ring-white/20">
                    <img src="./APEX%20logo.jpeg" alt="APEX logo icon" class="w-full h-full object-cover block">
                </div>

                <h1 class="text-5xl md:text-6xl font-bold text-white mb-4 tracking-tight uppercase reveal-left">
                    APEX
                </h1>
                
                <p class="text-gray-200 text-sm md:text-base leading-relaxed mb-8 max-w-lg font-medium reveal-left delay-100">
                    APEX OFFERS YOU A VARIETY OF SERVICES AND EXPERIENCES FOR B2B & B2C CUSTOMERS LIKE CLOTHING, FASHION, FINANCE, REALTY AND MORE... <a href="#" class="text-white underline font-bold">View More</a>
                </p>
                
                <a href="#store" class="inline-block bg-white text-black font-semibold text-sm py-3 px-8 rounded-full shadow-lg hover:bg-gray-100 transition-colors reveal-up delay-200">
                    Explore Ecosystem
                </a>

            </div>
        </div>
    </section>

    <!-- 1. STORE SECTION (Exact match to Image 2) -->
    <section id="store" class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold text-black uppercase mb-10 border-b-2 border-gray-100 pb-4 inline-block reveal-up">Clothing</h2>

            <!-- Product Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12">
                
                <!-- Product 1 -->
                <div class="product-card group cursor-pointer reveal-zoom delay-100">
                    <div class="product-img-container relative mb-4 bg-gray-50 h-[300px] flex items-center justify-center border border-gray-100">
                        <img src="https://images.unsplash.com/photo-1603487742131-4160ec999306?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Cotton Blouse" class="product-img w-full h-full object-cover">
                        <div class="absolute bottom-0 left-0 bg-[#4CAF50] text-white text-[11px] font-bold px-2 py-1">
                            40% OFF
                        </div>
                    </div>
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-[13px] font-bold text-gray-800 uppercase mb-1">Cotton Blouse</h3>
                            <div class="flex items-center gap-2">
                                <span class="text-apex-brown font-bold text-lg">₹60</span>
                                <span class="text-gray-400 line-through text-sm">₹100</span>
                            </div>
                        </div>
                        <button class="border border-gray-400 text-gray-800 rounded-full px-5 py-1 text-[13px] font-semibold hover:bg-black hover:text-white hover:border-black transition-colors">
                            ADD
                        </button>
                    </div>
                </div>

                <!-- Product 2 -->
                <div class="product-card group cursor-pointer reveal-zoom delay-200">
                    <div class="product-img-container relative mb-4 bg-gray-50 h-[300px] flex items-center justify-center border border-gray-100">
                        <img src="https://images.unsplash.com/photo-1506629082955-511b1aa562c8?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Soft Leggings" class="product-img w-full h-full object-cover p-4">
                        <div class="absolute bottom-0 left-0 bg-[#4CAF50] text-white text-[11px] font-bold px-2 py-1">
                            20% OFF
                        </div>
                    </div>
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-[13px] font-bold text-gray-800 uppercase mb-1">Soft Leggings</h3>
                            <div class="flex items-center gap-2">
                                <span class="text-apex-brown font-bold text-lg">₹400</span>
                                <span class="text-gray-400 line-through text-sm">₹500</span>
                            </div>
                        </div>
                        <button class="border border-gray-400 text-gray-800 rounded-full px-5 py-1 text-[13px] font-semibold hover:bg-black hover:text-white hover:border-black transition-colors">
                            ADD
                        </button>
                    </div>
                </div>

                <!-- Product 3 -->
                <div class="product-card group cursor-pointer reveal-zoom delay-300">
                    <div class="product-img-container relative mb-4 bg-gray-50 h-[300px] flex items-center justify-center border border-gray-100">
                        <img src="https://images.unsplash.com/photo-1589810635657-232948472d98?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Chunni" class="product-img w-full h-full object-cover">
                        <div class="absolute bottom-0 left-0 bg-[#4CAF50] text-white text-[11px] font-bold px-2 py-1">
                            50% OFF
                        </div>
                    </div>
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-[13px] font-bold text-gray-800 uppercase mb-1">Chunni</h3>
                            <div class="flex items-center gap-2">
                                <span class="text-apex-brown font-bold text-lg">₹100</span>
                                <span class="text-gray-400 line-through text-sm">₹200</span>
                            </div>
                        </div>
                        <button class="border border-gray-400 text-gray-800 rounded-full px-5 py-1 text-[13px] font-semibold hover:bg-black hover:text-white hover:border-black transition-colors">
                            ADD
                        </button>
                    </div>
                </div>

                <!-- Product 4 -->
                <div class="product-card group cursor-pointer reveal-zoom delay-400">
                    <div class="product-img-container relative mb-4 bg-gray-50 h-[300px] flex items-center justify-center border border-gray-100">
                        <img src="https://images.unsplash.com/photo-1582142407894-ec85a1260a46?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Sharee Peticoat" class="product-img w-full h-full object-cover p-8 bg-white">
                        <div class="absolute bottom-0 left-0 bg-[#4CAF50] text-white text-[11px] font-bold px-2 py-1">
                            25% OFF
                        </div>
                    </div>
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-[13px] font-bold text-gray-800 uppercase mb-1">Sharee Peticoat Cotton</h3>
                            <div class="flex items-center gap-2">
                                <span class="text-apex-brown font-bold text-lg">₹120</span>
                                <span class="text-gray-400 line-through text-sm">₹160</span>
                            </div>
                        </div>
                        <button class="border border-gray-400 text-gray-800 rounded-full px-5 py-1 text-[13px] font-semibold hover:bg-black hover:text-white hover:border-black transition-colors">
                            ADD
                        </button>
                    </div>
                </div>

                <!-- Additional row to show it's a full grid -->
                <div class="product-card group cursor-pointer reveal-zoom delay-500">
                    <div class="product-img-container relative mb-4 bg-gray-50 h-[300px] flex items-center justify-center border border-gray-100">
                        <img src="https://images.unsplash.com/photo-1618932260643-eee4a2f652a6?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Designer Saree" class="product-img w-full h-full object-cover">
                    </div>
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-[13px] font-bold text-gray-800 uppercase mb-1">Designer Saree</h3>
                            <div class="flex items-center gap-2">
                                <span class="text-apex-brown font-bold text-lg">₹1500</span>
                            </div>
                        </div>
                        <button class="border border-gray-400 text-gray-800 rounded-full px-5 py-1 text-[13px] font-semibold hover:bg-black hover:text-white hover:border-black transition-colors">
                            ADD
                        </button>
                    </div>
                </div>
            </div>
        </div>
