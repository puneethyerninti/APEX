    <!-- JavaScript logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Remove Loader
            setTimeout(() => {
                const loader = document.getElementById('loader');
                loader.style.opacity = '0';
                setTimeout(() => loader.style.display = 'none', 500);
            }, 600);

            // Mobile Menu Toggle
            const btn = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            const mobileLinks = document.querySelectorAll('.mobile-link');
            const mobileProfileMenuBtn = document.getElementById('mobile-profile-menu-btn');
            const mobileProfileMenu = document.getElementById('mobile-profile-menu');
            const mobileProfileMenuWrapper = document.getElementById('mobile-profile-menu-wrapper');
            const profileMenuBtn = document.getElementById('profile-menu-btn');
            const profileMenu = document.getElementById('profile-menu');
            const profileMenuWrapper = document.getElementById('profile-menu-wrapper');
            const realtyTrack = document.getElementById('realty-carousel-track');
            const realtyPrev = document.getElementById('realty-prev');
            const realtyNext = document.getElementById('realty-next');
            const realtyProgress = document.getElementById('realty-carousel-progress');
            const realtyCounter = document.getElementById('realty-carousel-counter');
            const realtyViewport = realtyTrack ? realtyTrack.parentElement : null;

            btn.addEventListener('click', () => {
                menu.classList.toggle('hidden');
            });

            mobileLinks.forEach(link => {
                link.addEventListener('click', () => {
                    menu.classList.add('hidden');
                });
            });

            mobileProfileMenuBtn.addEventListener('click', (event) => {
                event.stopPropagation();
                const isHidden = mobileProfileMenu.classList.contains('hidden');
                mobileProfileMenu.classList.toggle('hidden');
                mobileProfileMenuBtn.setAttribute('aria-expanded', String(isHidden));
            });

            profileMenuBtn.addEventListener('click', (event) => {
                event.stopPropagation();
                const isHidden = profileMenu.classList.contains('hidden');
                profileMenu.classList.toggle('hidden');
                profileMenuBtn.setAttribute('aria-expanded', String(isHidden));
            });

            document.addEventListener('click', (event) => {
                if (!profileMenuWrapper.contains(event.target)) {
                    profileMenu.classList.add('hidden');
                    profileMenuBtn.setAttribute('aria-expanded', 'false');
                }
                if (!mobileProfileMenuWrapper.contains(event.target)) {
                    mobileProfileMenu.classList.add('hidden');
                    mobileProfileMenuBtn.setAttribute('aria-expanded', 'false');
                }
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    profileMenu.classList.add('hidden');
                    profileMenuBtn.setAttribute('aria-expanded', 'false');
                    mobileProfileMenu.classList.add('hidden');
                    mobileProfileMenuBtn.setAttribute('aria-expanded', 'false');
                }
            });

            if (realtyTrack && realtyPrev && realtyNext) {
                const originalCards = Array.from(realtyTrack.children);
                const totalCards = originalCards.length;
                originalCards.forEach((card) => {
                    realtyTrack.appendChild(card.cloneNode(true));
                });

                let currentIndex = 0;
                let slideWidth = 0;
                let slideGap = 0;
                let autoAdvanceTimer = null;

                const measureSlides = () => {
                    const firstCard = realtyTrack.children[0];
                    if (!firstCard) {
                        return;
                    }

                    const computedStyles = window.getComputedStyle(realtyTrack);
                    slideGap = parseFloat(computedStyles.columnGap || computedStyles.gap || '0') || 0;
                    slideWidth = firstCard.getBoundingClientRect().width;
                };

                const updateCarousel = (animate = true) => {
                    if (!slideWidth) {
                        measureSlides();
                    }

                    realtyTrack.style.transition = animate ? 'transform 700ms cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
                    realtyTrack.style.transform = `translateX(-${currentIndex * (slideWidth + slideGap)}px)`;

                    const displayIndex = (currentIndex % totalCards) + 1;
                    if (realtyCounter) realtyCounter.textContent = `${String(displayIndex).padStart(2, '0')} / ${String(totalCards).padStart(2, '0')}`;
                    if (realtyProgress) realtyProgress.style.width = `${(displayIndex / totalCards) * 100}%`;

                    if (!animate) {
                        window.requestAnimationFrame(() => {
                            realtyTrack.style.transition = 'transform 700ms cubic-bezier(0.22, 1, 0.36, 1)';
                        });
                    }
                };

                const goNext = () => {
                    currentIndex += 1;
                    updateCarousel(true);
                };

                const goPrev = () => {
                    if (currentIndex === 0) {
                        currentIndex = totalCards - 1;
                        updateCarousel(false);
                        return;
                    }

                    currentIndex -= 1;
                    updateCarousel(true);
                };

                realtyTrack.addEventListener('transitionend', () => {
                    if (currentIndex >= totalCards) {
                        currentIndex = 0;
                        updateCarousel(false);
                    }
                });

                const startAutoAdvance = () => {
                    stopAutoAdvance();
                    autoAdvanceTimer = window.setInterval(goNext, 3600);
                };

                const stopAutoAdvance = () => {
                    if (autoAdvanceTimer) {
                        window.clearInterval(autoAdvanceTimer);
                        autoAdvanceTimer = null;
                    }
                };

                realtyPrev.addEventListener('click', () => {
                    stopAutoAdvance();
                    goPrev();
                    startAutoAdvance();
                });

                realtyNext.addEventListener('click', () => {
                    stopAutoAdvance();
                    goNext();
                    startAutoAdvance();
                });

                if (realtyViewport) {
                    realtyViewport.addEventListener('mouseenter', stopAutoAdvance);
                    realtyViewport.addEventListener('mouseleave', startAutoAdvance);
                }

                window.addEventListener('resize', () => {
                    measureSlides();
                    updateCarousel(false);
                });

                measureSlides();
                updateCarousel(false);
                startAutoAdvance();
            }

            // Presentation Animations (Intersection Observer)
            const revealElements = document.querySelectorAll('.reveal-up, .reveal-left, .reveal-right, .reveal-zoom');
            
            const revealOptions = {
                threshold: 0.1,
                rootMargin: "0px 0px -50px 0px"
            };

            const revealObserver = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('reveal-active');
                        observer.unobserve(entry.target); // Animate only once
                    }
                });
            }, revealOptions);

            revealElements.forEach(el => {
                revealObserver.observe(el);
            });
        });
    </script>
</body>
</html>